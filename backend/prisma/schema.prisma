generator client {
  provider = "prisma-client-js"
}

model Blogger {
  id                  Int       @id @default(autoincrement())
  name                String
  type                String
  url                 String    @unique
  avatar              String?
  description         String?
  isActive            Boolean   @default(true) @map("is_active")
  lastCheckedAt       DateTime? @map("last_checked_at")
  fetchStatus         String?   @default("pending") @map("fetch_status")
  fetchError          String?   @map("fetch_error")
  fetchFailCount      Int       @default(0) @map("fetch_fail_count")
  lastFetchSuccessAt  DateTime? @map("last_fetch_success_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  contents            Content[]

  @@index([type])
  @@index([isActive])
  @@index([fetchStatus])
  @@index([createdAt])
  @@map("bloggers")
}

model Content {
  id          Int       @id @default(autoincrement())
  bloggerId   Int       @map("blogger_id")
  title       String
  content     String?
  url         String
  publishedAt DateTime? @map("published_at")
  fetchedAt   DateTime  @default(now()) @map("fetched_at")
  isNotified  Boolean   @default(false) @map("is_notified")

  blogger     Blogger   @relation(fields: [bloggerId], references: [id], onDelete: Cascade)

  @@index([bloggerId])
  @@index([publishedAt])
  @@index([fetchedAt])
  @@index([isNotified])
  @@index([bloggerId, isNotified])
  @@index([bloggerId, publishedAt])
  @@unique([bloggerId, url])
  @@map("contents")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  email     String?  @unique
  avatar    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Config {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("configs")
}

model ReadHistory {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  contentId Int      @map("content_id")
  readAt    DateTime @default(now()) @map("read_at")

  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
  @@map("read_history")
}

model UserSubscription {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  bloggerId   Int      @map("blogger_id")
  subscribedAt DateTime @default(now()) @map("subscribed_at")

  @@unique([userId, bloggerId])
  @@index([userId])
  @@index([bloggerId])
  @@map("user_subscriptions")
}

model RssMarket {
  id              Int      @id @default(autoincrement())
  name            String
  url             String
  description     String?
  category        String
  icon            String?
  language        String?
  isFeatured      Boolean  @default(false) @map("is_featured")
  subscriberCount Int      @default(0) @map("subscriber_count")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([isFeatured])
  @@index([subscriberCount])
  @@map("rss_market")
}

model EmailLog {
  id            Int      @id @default(autoincrement())
  sendDate      DateTime @map("send_date")
  contentCount  Int      @map("content_count")
  status        String
  errorMessage  String?  @map("error_message")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([sendDate])
  @@index([status])
  @@map("email_logs")
}
