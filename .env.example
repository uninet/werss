# Vercel Environment Variables
# 复制此文件为 .env.local 并填入实际值

# Database
DATABASE_URL=postgresql://postgres:[password]@db.[project-id].supabase.co:5432/postgres

# JWT
JWT_SECRET=your-jwt-secret-here

# Email (可选)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_TO=

# GitHub Token (可选)
GITHUB_TOKEN=
